DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset for SQLite; set to "postgres" for the original PostgreSQL setup
INVENTARIOS_DB_ENGINE=
INVENTARIOS_DB_NAME=inventarios
INVENTARIOS_DB_USER=scrum
INVENTARIOS_DB_PASSWORD=
INVENTARIOS_DB_HOST=localhost
INVENTARIOS_DB_PORT=

# Account that sends purchase orders to suppliers (SMTP over SSL by default)
INVENTARIOS_EMAIL_HOST=smtp.gmail.com
INVENTARIOS_EMAIL_PORT=465
INVENTARIOS_EMAIL_USE_SSL=1
INVENTARIOS_EMAIL_USER=
INVENTARIOS_EMAIL_PASSWORD=
